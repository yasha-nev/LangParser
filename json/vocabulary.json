{
  "vocabulary": {
    "OPERATOR": ["-", "+", "/", "*"],
    "CONDITION": ["<>", ">=", "<=", "<", ">", "==", "="],
    "LOGIC": ["not", "or", "and"],
    "TYPES": ["int", "float", "bool"],
    "LOOP": [ "for",  "while"],
    "BRANCHING" : ["if", "else"],
    "KEYWORD": [
      "then",
      "to",
      "do",
      "read",
      "write"
    ],
    "END": ["{", "}", ";", ":", "(", ")", ","],
    "VARIABLES": ["[a-zA-Z]+"],
    "VALUE": ["\\d+"],
    "SPACE": ["[\\s\\n\\t]+"],
    "NONTERMINAL": ["<start>", "<stmt-list>", "<stmt-seq>", "<stmt>", "<decl-stmt>", "<loop-stmt>", "<branch-stmt>", "<assignment-stmt>", "<var-name>", "<cond-expr>", "<arithm-expr>", "<type-decl>", "<variables>", "<value>"]
  }
}
