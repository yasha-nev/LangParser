{
  "rules": {
    "A": [["{", "A0", "}"]],
    "A0": [["A0", "A0"], ["A0", "A0"], ["B"], ["C"]],
    "B": [
      ["E", ":", "TYPES", ";"],
      ["B", "B"]
    ],
    "C": [
      ["while", "F", "do", "{", "C", "}"],
      ["for", "D", "to", "G", "do", "{", "C", "}"],
      ["if", "F", "then", "{", "C", "}"],
      ["if", "F", "then", "{", "C", "}", "else", "{", "C", "}"],
      ["D"],
      ["C", "C"]
    ],
    "D": [["E", "=", "G", ";"]],
    "E": [["VARIABLES"], ["E", "E"]],    
    "F": [
      ["F"],
      ["(", "F", ")"],
      ["F", "or", "F"],
      ["F", "and", "F"],
      ["G", "=", "G"],
      ["G", "<", "G"],
      ["G", "<>", "G"],
      ["G", ">", "G"],
      ["G", "<=", "G"],
      ["G", ">=", "G"],
      ["G"]
    ],
    "G": [
      ["H"],
      ["(", "G", ")"],
      ["G", "+", "G"],
      ["G", "-", "G"],
      ["G", "*", "G"],
      ["G", "\\", "G"]
    ],
    "H": [["VARIABLES"], ["VALUE"], ["not F"]]
  }
}
