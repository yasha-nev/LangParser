{
  "rules": {
    "<stmt-list>": [["{", "<stmt-seq>", "}"]],
    "<stmt-seq>": [["<stmt-seq>", "<stmt-seq>"], ["<decl-stmt>"], ["<control-flow-stmt>"]],
    "<decl-stmt>": [
      ["<var-name>", ":", "<type-decl>", ";"]
    ],
    "<control-flow-stmt>": [
      ["while", "<cond-expr>", "do", "{", "<control-flow-stmt>", "}"],
      ["for", "<assignment>", "to", "<arithm-expr>", "do", "{", "<control-flow-stmt>", "}"],
      ["if", "<cond-expr>", "then", "{", "<control-flow-stmt>", "}"],
      ["if", "<cond-expr>", "then", "{", "<control-flow-stmt>", "}", "else", "{", "<control-flow-stmt>", "}"],
      ["<assignment>"]
    ],
    "<assignment>": [["<var-name>", "=", "<arithm-expr>", ";"]],
    "<var-name>": [["<variables>"], ["<var-name>", ",", "<var-name>"], [",", "<var-name>"]],
    "<cond-expr>": [
      ["<cond-expr>"],
      ["(", "<cond-expr>", ")"],
      ["<cond-expr>", "or", "<cond-expr>"],
      ["<cond-expr>", "and", "<cond-expr>"],
      ["<arithm-expr>", "=", "<arithm-expr>"],
      ["<arithm-expr>", "<", "<arithm-expr>"],
      ["<arithm-expr>", "<>", "<arithm-expr>"],
      ["<arithm-expr>", ">", "<arithm-expr>"],
      ["<arithm-expr>", "<=", "<arithm-expr>"],
      ["<arithm-expr>", ">=", "<arithm-expr>"],
      ["<arithm-expr>"]
    ],
    "<arithm-expr>": [
      ["(", "<arithm-expr>", ")"],
      ["<arithm-expr>", "+", "<arithm-expr>"],
      ["<arithm-expr>", "-", "<arithm-expr>"],
      ["<arithm-expr>", "*", "<arithm-expr>"],
      ["<arithm-expr>", "\\", "<arithm-expr>"],
      ["<variables>"],
      ["<value>"]
    ]
  }
}
