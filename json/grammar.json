{
  "rules": {
    "<stmt-list>": [["{", "<stmt-seq>", "}"]],
    "<stmt-seq>": [["<stmt-seq>", "<stmt-seq>"], ["<stmt>"]],
    
    "<stmt>": [
      ["<decl-stmt>"],
      ["<assignment-stmt>"],
      ["<loop-stmt>"],
      ["<branch-stmt>"]
    ],
    "<assignment-stmt>": [["<var-name>", "=", "<arithm-expr>", ";"]],
    "<decl-stmt>": [
      ["<var-name>", ":", "<type-decl>", ";"]
    ],
    "<loop-stmt>": [
      ["while", "(", "<cond-expr>", ")", "{", "<stmt-seq>", "}"],
      ["for", "(" ,"<assignment-stmt>", "<cond-expr>", ";", "<assignment-stmt>", ")", "{", "<stmt-seq>", "}"]
    ],
    "<branch-stmt>": [
      ["if", "(", "<cond-expr>", ")", "{", "<stmt-seq>", "}"],
      ["if", "(", "<cond-expr>", ")", "{", "<stmt-seq>", "}", "else", "{", "<stmt-seq>", "}"]
    ],
    "<var-name>": [["<variables>"], ["<var-name>", ",", "<var-name>"], [",", "<var-name>"]],
    "<cond-expr>": [
      ["(", "<cond-expr>", ")"],
      ["<cond-expr>", "or", "<cond-expr>"],
      ["<cond-expr>", "and", "<cond-expr>"],
      ["<arithm-expr>", "==", "<arithm-expr>"],
      ["<arithm-expr>", "<", "<arithm-expr>"],
      ["<arithm-expr>", "<>", "<arithm-expr>"],
      ["<arithm-expr>", ">", "<arithm-expr>"],
      ["<arithm-expr>", "<=", "<arithm-expr>"],
      ["<arithm-expr>", ">=", "<arithm-expr>"],
      ["<arithm-expr>"]
    ],
    "<arithm-expr>": [
      ["(", "<arithm-expr>", ")"],
      ["<arithm-expr>", "+", "<arithm-expr>"],
      ["<arithm-expr>", "-", "<arithm-expr>"],
      ["<arithm-expr>", "*", "<arithm-expr>"],
      ["<arithm-expr>", "\\", "<arithm-expr>"],
      ["<variables>"],
      ["<value>"]
    ]
  }
}
