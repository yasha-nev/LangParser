{
    "vocabulary" : {
        "OPERATOR": ["-", "\\+", "/", "\\*"],
        "CONDITION": ["<>", "=", ">=", "<=", "<", ">"],
        "LOGIC": ["not", "or", "and"],
        "TYPES": [ "%", "!", "\\$" ],
        "KEYWORD": ["ass", "for", "while", "if", "then", "else", "to", "do", "read", "write", "begin", "end"],
        "END": ["\\{", "\\}", ";", ":", "\\(", "\\)"],
        "VARIABLES": ["[a-zA-Z]+"],
        "VALUE": ["\\d+"],
        "SPACE": ["[\\s\\n\\t]+"]
    },
    "rules" : {
        "A" : [
            ["{", "A0", "}", "end"]
        ],
        "A0": [
            ["B"],
            ["D"], 
            ["B", "A0"],
            ["D", "A0"]
        ],
        "B" : [
            ["C", ":", "TYPES", ";"],
            ["B", "B"]
        ],
        "C" : [
            ["VARIABLES"], 
            ["C", "C"]
        ],
        "D" : [
            ["while", "F", "do", "{", "D", "}"],
            ["for", "E", "to", "G", "do", "{", "D", "}"],
            ["if", "F", "then", "{", "D", "}"],
            ["if", "F", "then", "{", "D", "}", "else", "{", "D", "}"],
            ["E"],
            ["D", "D"]
        ],
        "E" : [
            ["C", "ass", "G", ";"] 
        ],
        "F" : [ 
            ["F"], 
            ["(", "F", ")"],
            ["F", "or", "F"],
            ["F", "and", "F"],
            ["G", "=", "G"],
            ["G", "<", "G"],
            ["G", "<>", "G"],
            ["G", ">", "G"],
            ["G", "<=", "G"],
            ["G", ">=", "G"], 
            ["G"]
        ],
        "G" : [ 
            ["H"], 
            ["(", "G", ")"],
            ["G", "+", "G"],
            ["G", "-", "G"],
            ["G", "*", "G"],
            ["G", "\\", "G"]
        ],
        "H" : [
            ["VARIABLES"], 
            ["VALUE"] , 
            ["not F"]
        ]
    }
}